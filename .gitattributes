# LF everywhere, including Windows working trees. Docker containers and CI run
# on Linux; CRLF in PHP or shell files causes noisy diffs and broken scripts.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Keep the Composer dist archive small: only what a consumer needs at runtime
# (src/, config/, composer.json, LICENSE, README.md, CHANGELOG.md) ships.
/.github            export-ignore
/docker             export-ignore
/docs               export-ignore
/tests              export-ignore
/workbench          export-ignore
/.dockerignore      export-ignore
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/docker-compose.yml export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/pint.json          export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore
